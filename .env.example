# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (.env.example)
# Portfolio of Anil Shrestha (https://anilshrestha11.com.np)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE PUBLIC VARIABLES (Safe to expose in browser bundle)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Supabase Dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase Anonymous Public Key (subject to Row Level Security / RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE PRIVILEGED VARIABLES (CRITICAL: NEVER expose in browser bundle)
# ------------------------------------------------------------------------------
# Server port for Express & Vite SSR integration (Default: 3000)
PORT=3000

# Node environment mode
NODE_ENV=development

# Server-Side Supabase Service Role Key (Bypasses RLS for secure admin server endpoints)
# CRITICAL: Keep this strictly on the backend / host environment. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Authorized Admin Email Address
# Only Supabase Auth tokens matching this email address or having app_metadata.role === 'admin'
# are permitted to perform administrative CRUD mutations on /api/admin/* routes.
ADMIN_EMAIL=anya.24x7@gmail.com
